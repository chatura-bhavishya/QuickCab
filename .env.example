# Copy this file to .env (or .env.local) and adjust. Never commit real .env files.
# Base URL of the Spring Boot API used by the React app.
VITE_API_BASE_URL=http://localhost:8080/api

# Optional: WebSocket URL for live updates. Defaults to the API URL with /api replaced by /ws.
# VITE_WS_URL=ws://localhost:8080/ws

# --- Only used by docker compose (not by Vite) ---
# MySQL root password for the bundled database container.
MYSQL_ROOT_PASSWORD=change-me
# Login token signing secret, at least 32 characters (e.g. openssl rand -base64 48).
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-chars
