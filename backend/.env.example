# Copy this file to backend/.env and fill in real values. Never commit backend/.env.
DB_URL=jdbc:mysql://localhost:3306/cabdb?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your-mysql-password

# Secret used to sign login tokens. Use a long random value (at least 32 characters), e.g.
#   openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-chars
# How long a login token stays valid
JWT_EXPIRATION_MINUTES=1440

PORT=8080
# Exact origin of the frontend (comma-separate if there are several)
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Set to true to log generated SQL while debugging
SHOW_SQL=false
