# Copy this file to backend/.env and fill in real values. Never commit backend/.env.
DB_URL=jdbc:mysql://localhost:3306/cabdb?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your-mysql-password
# Set to true to log generated SQL while debugging
SHOW_SQL=false
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:*
